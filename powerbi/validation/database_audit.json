  "view_definitions": [
    {
      "viewname": "vw_daily_disruption_trends",
      "definition": " SELECT ((snapshot_time AT TIME ZONE 'Europe/London'::text))::date AS observation_date,\n    count(DISTINCT snapshot_time) AS snapshots_collected,\n    count(*) AS total_line_observations,\n    count(*) FILTER (WHERE was_disrupted) AS disrupted_line_observations,\n    count(*) FILTER (WHERE was_good_service) AS good_service_observations,\n    round(((100.0 * (count(*) FILTER (WHERE was_disrupted))::numeric) / (NULLIF(count(*), 0))::numeric), 2) AS observed_disruption_pct\n   FROM analytics.vw_line_snapshot_status\n  GROUP BY (((snapshot_time AT TIME ZONE 'Europe/London'::text))::date);"
    },
    {
      "viewname": "vw_disruption_severity",
      "definition": " SELECT status_severity,\n    status_description,\n    count(*) AS total_status_records,\n    count(DISTINCT snapshot_time) AS snapshots_observed,\n    count(DISTINCT line_id) AS affected_tube_lines,\n    round(((100.0 * (count(*))::numeric) / NULLIF(sum(count(*)) OVER (), (0)::numeric)), 2) AS percentage_of_records\n   FROM staging.tube_status_history\n  GROUP BY status_severity, status_description;"
    },
    {
      "viewname": "vw_line_reliability",
      "definition": " SELECT line_id,\n    line_name,\n    count(*) AS total_snapshots,\n    count(*) FILTER (WHERE was_disrupted) AS disrupted_snapshots,\n    count(*) FILTER (WHERE was_good_service) AS good_service_snapshots,\n    round(((100.0 * (count(*) FILTER (WHERE was_good_service))::numeric) / (NULLIF(count(*), 0))::numeric), 2) AS observed_good_service_pct,\n    round(((100.0 * (count(*) FILTER (WHERE was_disrupted))::numeric) / (NULLIF(count(*), 0))::numeric), 2) AS observed_disruption_pct\n   FROM analytics.vw_line_snapshot_status\n  GROUP BY line_id, line_name;"
    },
    {
      "viewname": "vw_line_snapshot_status",
      "definition": " SELECT h.line_id,\n    l.line_name,\n    h.snapshot_time,\n    count(*) AS status_records,\n    bool_or((h.status_severity <> 10)) AS was_disrupted,\n    bool_and((h.status_severity = 10)) AS was_good_service\n   FROM (staging.tube_status_history h\n     JOIN staging.tube_lines l ON (((h.line_id)::text = (l.line_id)::text)))\n  GROUP BY h.line_id, l.line_name, h.snapshot_time;"
    },
    {
      "viewname": "vw_major_disruptions_by_line",
      "definition": " WITH line_snapshot_flags AS (\n         SELECT tube_status_history.line_id,\n            tube_status_history.snapshot_time,\n            bool_or(((tube_status_history.status_description)::text = 'Severe Delays'::text)) AS has_severe_delays,\n            bool_or(((tube_status_history.status_description)::text = ANY ((ARRAY['Part Closure'::character varying, 'Part Suspended'::character varying])::text[]))) AS has_closure_or_suspension,\n            bool_or(((tube_status_history.status_description)::text = 'Planned Closure'::text)) AS has_planned_closure\n           FROM staging.tube_status_history\n          GROUP BY tube_status_history.line_id, tube_status_history.snapshot_time\n        )\n SELECT l.line_id,\n    l.line_name,\n    count(*) AS snapshots_observed,\n    count(*) FILTER (WHERE s.has_severe_delays) AS severe_delay_snapshots,\n    count(*) FILTER (WHERE s.has_closure_or_suspension) AS closure_or_suspension_snapshots,\n    count(*) FILTER (WHERE s.has_planned_closure) AS planned_closure_snapshots,\n    count(*) FILTER (WHERE (s.has_severe_delays OR s.has_closure_or_suspension OR s.has_planned_closure)) AS major_status_snapshots\n   FROM (line_snapshot_flags s\n     JOIN staging.tube_lines l ON (((s.line_id)::text = (l.line_id)::text)))\n  GROUP BY l.line_id, l.line_name;"
    },
    {
      "viewname": "vw_operational_kpi_summary",
      "definition": " WITH snapshot_summary AS (\n         SELECT count(DISTINCT vw_line_snapshot_status.line_id) AS tube_lines_monitored,\n            count(DISTINCT vw_line_snapshot_status.snapshot_time) AS total_snapshots,\n            count(*) AS total_line_observations,\n            count(*) FILTER (WHERE vw_line_snapshot_status.was_good_service) AS good_service_observations,\n            count(*) FILTER (WHERE vw_line_snapshot_status.was_disrupted) AS disrupted_observations,\n            min(vw_line_snapshot_status.snapshot_time) AS first_snapshot_time,\n            max(vw_line_snapshot_status.snapshot_time) AS latest_snapshot_time\n           FROM analytics.vw_line_snapshot_status\n        ), major_summary AS (\n         SELECT COALESCE(sum(vw_major_disruptions_by_line.major_status_snapshots), (0)::numeric) AS major_status_observations,\n            COALESCE(sum(vw_major_disruptions_by_line.planned_closure_snapshots), (0)::numeric) AS planned_closure_observations\n           FROM analytics.vw_major_disruptions_by_line\n        )\n SELECT s.tube_lines_monitored,\n    s.total_snapshots,\n    s.total_line_observations,\n    s.good_service_observations,\n    s.disrupted_observations,\n    round(((100.0 * (s.good_service_observations)::numeric) / (NULLIF(s.total_line_observations, 0))::numeric), 2) AS observed_good_service_pct,\n    round(((100.0 * (s.disrupted_observations)::numeric) / (NULLIF(s.total_line_observations, 0))::numeric), 2) AS observed_disruption_pct,\n    m.major_status_observations,\n    m.planned_closure_observations,\n    s.first_snapshot_time,\n    s.latest_snapshot_time\n   FROM (snapshot_summary s\n     CROSS JOIN major_summary m);"
    }
  ]
}
