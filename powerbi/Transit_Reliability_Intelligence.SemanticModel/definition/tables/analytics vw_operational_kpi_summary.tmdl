	partition 'analytics vw_operational_kpi_summary' = m
		mode: import
		source =
				let
				    Source = PostgreSQL.Database("localhost:5432", "transit_reliability_intelligence"),
				    analytics_vw_operational_kpi_summary = Source{[Schema="analytics",Item="vw_operational_kpi_summary"]}[Data]
				in
