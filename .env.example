# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=transit_reliability_intelligence
DB_USER=postgres
DB_PASSWORD=your_password_here

# Optional TfL app key; never commit a real key.
TFL_API_KEY=

# Optional archival. Disabled by default; loopback emulation only.
S3_ENABLED=false
S3_MODE=local
S3_ENDPOINT_URL=http://127.0.0.1:5000
S3_BUCKET=transit-snapshots-local
S3_PREFIX=raw/tfl/tube
AWS_REGION=eu-west-2
S3_ALLOW_AWS=false

# Optional Lambda settings (normally supplied by Terraform, never secrets).
# PIPELINE_NAME=transit-reliability-ingestion
# EXPECTED_SCHEDULE_ARN=arn:aws:scheduler:eu-west-2:ACCOUNT_ID:schedule/transit-reliability/transit-reliability-hourly
# TFL_SECRET_ARN=  # Secret ARN only; do not place the secret value here for Lambda.
